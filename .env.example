# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION FOR URBANFIX
# Copy your Project URL and Publishable (Anon) Key from Supabase Project Settings > API.
# Never place service_role keys or database passwords in client environment variables.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
